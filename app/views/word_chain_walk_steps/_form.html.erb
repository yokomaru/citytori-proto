<%= form_with(model: word_chain_walk_step, class: "contents") do |form| %>
  <% if word_chain_walk_step.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(word_chain_walk_step.errors.count, "error") %> prohibited this word_chain_walk_step from being saved:</h2>

      <ul class="list-disc ml-6">
        <% word_chain_walk_step.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :word %>
    <%= form.text_field :word, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": word_chain_walk_step.errors[:word].none?, "border-red-400 focus:outline-red-600": word_chain_walk_step.errors[:word].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :memo %>
    <%= form.text_area :memo, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": word_chain_walk_step.errors[:memo].none?, "border-red-400 focus:outline-red-600": word_chain_walk_step.errors[:memo].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :index %>
    <%= form.number_field :index, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": word_chain_walk_step.errors[:index].none?, "border-red-400 focus:outline-red-600": word_chain_walk_step.errors[:index].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :latitude %>
    <%= form.text_field :latitude, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": word_chain_walk_step.errors[:latitude].none?, "border-red-400 focus:outline-red-600": word_chain_walk_step.errors[:latitude].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :longitude %>
    <%= form.text_field :longitude, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": word_chain_walk_step.errors[:longitude].none?, "border-red-400 focus:outline-red-600": word_chain_walk_step.errors[:longitude].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :word_chain_walk_id %>
    <%= form.text_field :word_chain_walk_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": word_chain_walk_step.errors[:word_chain_walk_id].none?, "border-red-400 focus:outline-red-600": word_chain_walk_step.errors[:word_chain_walk_id].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
