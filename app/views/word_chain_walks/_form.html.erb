<%= form_with(model: word_chain_walk, class: "contents") do |form| %>
  <% if word_chain_walk.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(word_chain_walk.errors.count, "error") %> prohibited this word_chain_walk from being saved:</h2>

      <ul class="list-disc ml-6">
        <% word_chain_walk.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :start_char %>
    <%= form.text_field :start_char, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": word_chain_walk.errors[:start_char].none?, "border-red-400 focus:outline-red-600": word_chain_walk.errors[:start_char].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :started_at %>
    <%= form.datetime_field :started_at, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": word_chain_walk.errors[:started_at].none?, "border-red-400 focus:outline-red-600": word_chain_walk.errors[:started_at].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :finished_at %>
    <%= form.datetime_field :finished_at, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": word_chain_walk.errors[:finished_at].none?, "border-red-400 focus:outline-red-600": word_chain_walk.errors[:finished_at].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
