<div id="<%= dom_id word_chain_walk %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Start char:</strong>
    <%= word_chain_walk.start_char %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Started at:</strong>
    <%= word_chain_walk.started_at %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Finished at:</strong>
    <%= word_chain_walk.finished_at %>
  </div>
</div>
