<% content_for :title, "散歩中の画面" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>
  <%= render 'shared/error_messages', object: @word_chain_walk_step %>

  <% if @word_chain_walk.finished? %>
    <div>
      かかった時間: <%= formatted_elapsed_time(word_chain_walk.elapsed_seconds) %>
    </div>
    <div>
      最初の言葉: <%= @word_chain_walk.start_char %>
    </div>
  <% else %>
    <div>
      <%= @word_chain_walk.target_char %>
    </div>
    <div>
      に続く言葉を街の中から見つけましょう
    </div>
    <div class="flex justify-between items-center">
      <%= link_to "写真を撮る", new_word_chain_walk_word_chain_walk_step_path(@word_chain_walk), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
    </div>
  <% end %>

  <div>
    <% if @word_chain_walk_steps.any? %>
      <div id="word_chain_walk_steps" class="min-w-full divide-y divide-gray-200 space-y-5">
        <% @word_chain_walk_steps.each do |word_chain_walk_step| %>
          <%= render 'word_chain_walk_step', word_chain_walk: @word_chain_walk, word_chain_walk_step: word_chain_walk_step %>
        <% end %>
      </div>
    <% end %>
  </div>
  <% unless @word_chain_walk.finished? %>
    <div>
      <%= button_to "散歩を完了する", word_chain_walk_completion_path(@word_chain_walk) , method: :patch, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "しりとり散歩を完了させて良いですか？" } %>
    </div>
  <% else %>
    <div id="all-pins-map-container" data-controller="all-pins-map" data-all-pins-map-positions-value="<%= @locations.to_json %>">
      <div class="leaflet-container" data-all-pins-map-target="placeholder" style="height: 500px; width: 500px;"></div>
    </div>
  <% end %>
  <div>
    <%= link_to "一覧へ戻る", word_chain_walks_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  </div>
</div>
