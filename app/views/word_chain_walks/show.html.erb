<% content_for :title, "散歩中の画面" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p
      class="
        py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md
        inline-block
      "
      id="notice"
    >
      <%= notice %>
    </p>
  <% end %>

  <%= render 'shared/error_messages', object: @word_chain_walk_step %>

  <% if @word_chain_walk.finished? %>
    <div>
      かかった時間:
      <%= formatted_elapsed_time(@word_chain_walk.elapsed_seconds) %>
    </div>

    <div>
      最初の言葉:
      <%= @word_chain_walk.start_char %>
    </div>
  <% else %>
    <%= render "word_chain_walks/target", word_chain_walk: @word_chain_walk %>

    <%= form_with(
      model: [@word_chain_walk, @word_chain_walk_step],
      data: {
        controller: "step-form previews geolocation",
        action: "
          previews:valid-file-selected->step-form#open
          previews:valid-file-selected->geolocation#fetchPosition
          turbo:submit-end->step-form#closeAfterSubmit
        "
      }
    ) do |form| %>
      <div class="mb-5">
        <%= form.file_field :image,
          accept: "image/jpeg,image/jpg,image/png",
          capture: "environment",
          style: "
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
          ",
          data: {
            previews_target: "input",
            action: "change->previews#preview"
          } %>

        <%= form.label :image,
          "写真を撮る",
          class: "
            inline-flex cursor-pointer items-center rounded-xl
            bg-blue-600 px-5 py-3 font-semibold text-white
            shadow-sm hover:bg-blue-500
          " %>
      </div>

      <div
        style="
          display: none;
          position: fixed;
          inset: 0;
          z-index: 50;
          align-items: center;
          justify-content: center;
          padding: 1rem;
          background: rgba(0, 0, 0, 0.5);
        "
        data-step-form-target="modal"
        data-action="click->step-form#closeWhenBackgroundClicked"
      >
        <div
          class="rounded-2xl bg-white p-6 shadow-2xl"
          style="
            width: min(100%, 32rem);
            max-height: calc(100vh - 2rem);
            overflow-y: auto;
          "
        >
          <div class="mb-5 flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-blue-600">
                しりとり散歩
              </p>

              <h2 class="mt-1 text-xl font-bold text-gray-900">
                見つけた言葉を登録
              </h2>
            </div>

            <button
              type="button"
              class="flex h-10 w-10 items-center justify-center rounded-full text-2xl text-gray-400 hover:bg-gray-100 hover:text-gray-700"
              aria-label="閉じる"
              data-action="click->step-form#close"
            >
              ×
            </button>
          </div>

          <div
            class="mb-5 overflow-hidden rounded-xl bg-gray-100"
            style="display: none;"
            data-previews-target="preview"
          >
            <img
              src=""
              alt="選択した画像のプレビュー"
              class="max-h-72 w-full object-contain"
              data-previews-target="image"
            >
          </div>

          <div class="mb-5 rounded-xl bg-blue-50 px-4 py-3">
            <p
              class="text-sm text-blue-700"
              data-geolocation-target="status"
            ></p>

            <p
              class="mt-1 text-xs text-blue-600"
              data-geolocation-target="position"
            ></p>
          </div>

          <%= form.hidden_field :latitude,
            data: { geolocation_target: "latitude" } %>

          <%= form.hidden_field :longitude,
            data: { geolocation_target: "longitude" } %>

          <div class="mb-6">
            <%= form.label :word,
              "見つけた言葉",
              class: "mb-2 block text-sm font-semibold text-gray-700" %>

            <%= form.text_field :word,
              class: "
                block w-full rounded-xl border border-gray-300
                px-4 py-3 text-lg outline-none
                placeholder:text-gray-400
                focus:border-blue-500 focus:ring-2 focus:ring-blue-100
              ",
              placeholder: "#{@word_chain_walk.target_char}から始まる言葉" %>
          </div>

          <div class="flex gap-3">
            <button
              type="button"
              class="flex-1 rounded-xl bg-gray-100 px-4 py-3 font-medium text-gray-700 hover:bg-gray-200"
              data-action="click->step-form#close"
            >
              キャンセル
            </button>

            <%= form.submit "登録する",
              class: "
                flex-1 cursor-pointer rounded-xl bg-blue-600
                px-4 py-3 font-semibold text-white
                shadow-sm hover:bg-blue-500
              " %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>

  <div>
    <% if @word_chain_walk_steps.any? %>
      <div
        id="word_chain_walk_steps"
        class="min-w-full divide-y divide-gray-200 space-y-5"
      >
        <% @word_chain_walk_steps.each do |word_chain_walk_step| %>
          <%= render 'word_chain_walk_step', word_chain_walk: @word_chain_walk, word_chain_walk_step: word_chain_walk_step %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% unless @word_chain_walk.finished? %>
    <div>
      <%= button_to "散歩を完了する",
        word_chain_walk_completion_path(@word_chain_walk),
        method: :patch,
        form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2",
        class: "
          w-full rounded-md bg-red-600 px-3.5 py-2.5
          font-medium text-white hover:bg-red-500 cursor-pointer
        ",
        data: {
          turbo_confirm: "しりとり散歩を完了させて良いですか？"
        } %>
    </div>
  <% else %>
    <% if @locations.present? %>
      <div
        id="all-pins-map-container"
        data-controller="all-pins-map"
        data-all-pins-map-positions-value="<%= @locations.to_json %>"
      >
        <div
          class="leaflet-container"
          data-all-pins-map-target="placeholder"
          style="height: 500px; width: 500px;"
        ></div>
      </div>
    <% end %>
  <% end %>

  <div>
    <%= link_to "一覧へ戻る",
      word_chain_walks_path,
      class: "
        mt-2 inline-block w-full rounded-md bg-gray-100
        px-3.5 py-2.5 text-center font-medium
        hover:bg-gray-50 sm:ml-2 sm:mt-0 sm:w-auto
      " %>
  </div>
</div>