<% content_for :title, "散歩中の画面" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>
  <% if @word_chain_walk_step&.errors&.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2>
        <%= pluralize(@word_chain_walk_step.errors.count, "error") %> prohibited this word_chain_walk from being saved:
      </h2>

      <ul class="list-disc ml-6">
        <% @word_chain_walk_step.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
      <%= @target_char %>
  </div>
  <div>
    に続く言葉を街の中から見つけましょう
  </div>

  <div>
    <div class="flex justify-between items-center">
    <%= link_to "写真を撮る", new_word_chain_walk_word_chain_walk_step_path(@word_chain_walk), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
    </div>
    <% if @word_chain_walk.finished_at.nil? && @word_chain_walk_steps.any? %>
      <div id="word_chain_walk_steps" class="min-w-full divide-y divide-gray-200 space-y-5">
          <% @word_chain_walk_steps.each do |word_chain_walk_step| %>
            <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
              <%= render word_chain_walk_step %>
              <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
                <% if @latest_step == word_chain_walk_step %>
                  <%= button_to "Destroy", latest_word_chain_walk_word_chain_walk_steps_path, method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
                <% end %>
              </div>
            </div>
          <% end %>
      </div>
    <% end %>
  </div>
  <div>
    <%= link_to "散歩を完了する", "#" %>
  </div>
</div>
