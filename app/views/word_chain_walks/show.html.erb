<% content_for :title, "散歩中の画面" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p
      class="
        py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md
        inline-block
      "
      id="notice"
    >
      <%= notice %>
    </p>
  <% end %>

  <%= render 'shared/error_messages', object: @word_chain_walk_step %>

  <% if @word_chain_walk.finished? %>
    <div>
      かかった時間:
      <%= formatted_elapsed_time(@word_chain_walk.elapsed_seconds) %>
    </div>

    <div>
      最初の言葉:
      <%= @word_chain_walk.start_char %>
    </div>
  <% else %>
    <div class="mb-1 text-2xl font-bold">
      <%= @word_chain_walk.target_char %>
    </div>

    <p class="mb-4">
      に続く言葉を街の中から見つけましょう
    </p>

  <%= form_with(
    model: [@word_chain_walk, @word_chain_walk_step],
    data: {
      controller: "step-form previews geolocation",
      action: "
        previews:valid-file-selected->step-form#open
        previews:valid-file-selected->geolocation#fetchPosition
      "
    }
    ) do |form| %>
      <div class="mb-4">
        <%= form.file_field :image,
          accept: "image/jpeg,image/jpg,image/png",
          capture: "environment",
          style: "position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;",
          data: {
            previews_target: "input",
            action: "change->previews#preview"
          } %>

        <%= form.label :image,
          "写真を撮る",
          class: "inline-flex cursor-pointer items-center rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500" %>
      </div>

      <div
        class="fixed inset-0 z-50 items-center justify-center bg-black/40 p-4"
        style="display: none;"
        data-step-form-target="modal"
        data-action="click->step-form#closeWhenBackgroundClicked"
      >
        <div class="w-full max-w-lg rounded-lg bg-white p-6 shadow-xl">
          <div class="mb-4 flex items-center justify-between">

            <button
              type="button"
              class="text-2xl text-gray-500 hover:text-gray-700"
              aria-label="閉じる"
              data-action="click->step-form#close"
            >
              ×
            </button>
          </div>

          <div class="hidden mb-4" data-previews-target="preview">
            <img
              src=""
              alt="選択した画像のプレビュー"
              class="max-h-64 w-full rounded-lg object-contain"
              data-previews-target="image"
            >
          </div>

          <p class="mb-1 text-sm text-gray-600" data-geolocation-target="status"></p>
          <p class="mb-4 text-sm text-gray-600" data-geolocation-target="position"></p>

          <%= form.hidden_field :latitude, data: { geolocation_target: "latitude" } %>
          <%= form.hidden_field :longitude, data: { geolocation_target: "longitude" } %>

          <div class="mb-4">
            <%= form.label :word, "見つけた言葉", class: "block text-sm font-medium" %>
            <%= form.text_field :word,
              class: "mt-1 block w-full rounded border-gray-300",
              placeholder: "#{@word_chain_walk.target_char}から始まる言葉" %>
          </div>

          <div class="flex gap-3">
            <button
              type="button"
              class="rounded bg-gray-200 px-4 py-2 hover:bg-gray-300"
              data-action="click->step-form#close"
            >
              キャンセル
            </button>

            <%= form.submit "登録する",
              class: "rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-500" %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>

  <div>
    <% if @word_chain_walk_steps.any? %>
      <div
        id="word_chain_walk_steps"
        class="min-w-full divide-y divide-gray-200 space-y-5"
      >
        <% @word_chain_walk_steps.each do |word_chain_walk_step| %>
          <%= render 'word_chain_walk_step', word_chain_walk: @word_chain_walk, word_chain_walk_step: word_chain_walk_step %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% unless @word_chain_walk.finished? %>
    <div>
      <%= button_to "散歩を完了する",
        word_chain_walk_completion_path(@word_chain_walk),
        method: :patch,
        form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2",
        class: "w-full rounded-md bg-red-600 px-3.5 py-2.5 font-medium text-white hover:bg-red-500 cursor-pointer",
        data: {
          turbo_confirm: "しりとり散歩を完了させて良いですか？"
        } %>
    </div>
  <% else %>
    <% if @locations.present? %>
      <div
        id="all-pins-map-container"
        data-controller="all-pins-map"
        data-all-pins-map-positions-value="<%= @locations.to_json %>"
      >
        <div
          class="leaflet-container"
          data-all-pins-map-target="placeholder"
          style="height: 500px; width: 500px;"
        ></div>
      </div>
    <% end %>
  <% end %>

  <div>
    <%= link_to "一覧へ戻る",
      word_chain_walks_path,
      class: "mt-2 inline-block w-full rounded-md bg-gray-100 px-3.5 py-2.5 text-center font-medium hover:bg-gray-50 sm:ml-2 sm:mt-0 sm:w-auto" %>
  </div>
</div>