<%= form_with(model: [word_chain_walk, word_chain_walk_step], class: "contents") do |form| %>
  <%= render 'shared/error_messages', object: form.object %>

  <div
    class="mb-6"
    data-controller="previews geolocation"
    data-action="previews:valid-file-selected->geolocation#fetchPosition"
  >
    <div class="my-5">
      <%= render 'image_preview', form: form, word_chain_walk_step: form.object %>
    </div>

    <p data-geolocation-target="status" class="mt-3 text-sm text-gray-600"></p>
    <p data-geolocation-target="position" class="text-sm text-gray-600"></p>

    <%# = form.hidden_field :latitude, data: { geolocation_target: "latitude" } %>
    <%# = form.hidden_field :longitude, data: { geolocation_target: "longitude" } %>

    <div class="my-5">
      <%= form.label :word %>
      <%= form.text_field :word, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": word_chain_walk_step.errors[:word].none?, "border-red-400 focus:outline-red-600": word_chain_walk_step.errors[:word].any?}] %>
    </div>

    <div class="my-5">
      <%= form.label :memo %>
      <%= form.text_area :memo, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": word_chain_walk_step.errors[:memo].none?, "border-red-400 focus:outline-red-600": word_chain_walk_step.errors[:memo].any?}] %>
    </div>

    <div class="my-5">
      <%= form.label :latitude %>
      <%= form.text_field :latitude, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": word_chain_walk_step.errors[:latitude].none?, "border-red-400 focus:outline-red-600": word_chain_walk_step.errors[:latitude].any?}], data: { geolocation_target: "latitude" } %>
    </div>

    <div class="my-5">
      <%= form.label :longitude %>
      <%= form.text_field :longitude, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": word_chain_walk_step.errors[:longitude].none?, "border-red-400 focus:outline-red-600": word_chain_walk_step.errors[:longitude].any?}], data: { geolocation_target: "longitude" } %>
    </div>

    <div class="inline">
      <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  </div>
<% end %>
