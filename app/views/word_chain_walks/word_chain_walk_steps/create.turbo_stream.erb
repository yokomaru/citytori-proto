<% if @word_chain_walk_step.persisted? %>
  <%= turbo_stream.prepend "word_chain_walk_steps" do %>
    <%= render "word_chain_walks/word_chain_walk_step",
      word_chain_walk: @word_chain_walk,
      word_chain_walk_step: @word_chain_walk_step %>
  <% end %>

  <%= turbo_stream.replace "word_chain_walk_target" do %>
    <%= render "word_chain_walks/target",
      word_chain_walk: @word_chain_walk %>
  <% end %>

  <%= turbo_stream.update "word_chain_walk_step_errors" do %>
    <%= render "shared/error_messages", object: @word_chain_walk_step %>
  <% end %>
<% else %>
  <%= turbo_stream.update "word_chain_walk_step_errors" do %>
    <%= render "shared/error_messages", object: @word_chain_walk_step %>
  <% end %>
<% end %>
