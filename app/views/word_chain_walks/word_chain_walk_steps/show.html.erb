<% content_for :title, "Showing word chain walk step" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p
      class="
        py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md
        inline-block
      "
      id="notice"
    >
      <%= notice %>
    </p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing word chain walk step</h1>

  <% if @word_chain_walk_step.latitude.present? && @word_chain_walk_step.longitude.present? %>
    <div data-controller="map">
      <%= render @word_chain_walk_step %>
    </div>
  <% else %>
    <%= render @word_chain_walk_step %>
  <% end %>

  <%= link_to "Back to word chain walk steps",
    word_chain_walk_path(@word_chain_walk_step.word_chain_walk),
    class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
